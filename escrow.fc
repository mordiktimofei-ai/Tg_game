;; TicTacBet Escrow Contract
;; Holds stakes and distributes winnings

#include "imports/stdlib.fc";

;; Storage layout:
;; player1_address: MsgAddress
;; player2_address: MsgAddress  
;; stake_amount: Coins
;; status: int (0=pending, 1=active, 2=completed)
;; winner: MsgAddress (optional)

(int, int, int, slice, slice, int, slice) load_data() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_uint(32),    ;; seqno
        ds~load_uint(32),    ;; status
        ds~load_coins(),     ;; stake
        ds~load_msg_addr(),  ;; player1
        ds~load_msg_addr(),  ;; player2
        ds~load_uint(32),    ;; created_at
        ds~load_msg_addr()   ;; winner (null if not set)
    );
}

() save_data(int seqno, int status, int stake, slice player1, slice player2, int created_at, slice winner) impure inline {
    set_data(begin_cell()
        .store_uint(seqno, 32)
        .store_uint(status, 32)
        .store_coins(stake)
        .store_slice(player1)
        .store_slice(player2)
        .store_uint(created_at, 32)
        .store_slice(winner)
        .end_cell());
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();  ;; Ignore empty messages
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();  ;; Ignore bounced messages
    }

    slice sender = cs~load_msg_addr();
    int op = in_msg_body~load_uint(32);

    var (seqno, status, stake, player1, player2, created_at, winner) = load_data();

    ;; op::join = 1
    if (op == 1) {
        throw_if(401, status != 0);  ;; Game not pending
        throw_if(402, msg_value < stake);  ;; Insufficient stake

        if (player1.slice_empty?()) {
            player1 = sender;
            save_data(seqno, 0, stake, player1, player2, created_at, winner);
        } else {
            throw_if(403, equal_slices(player1, sender));  ;; Already joined
            player2 = sender;
            save_data(seqno, 1, stake, player1, player2, now(), winner);
        }
        return ();
    }

    ;; op::end_game = 2
    if (op == 2) {
        throw_if(404, status != 1);  ;; Game not active
        throw_if(405, ~ equal_slices(sender, player1) & ~ equal_slices(sender, player2));  ;; Not a player

        slice game_winner = in_msg_body~load_msg_addr();
        int platform_fee = stake * 2 * 5 / 100;  ;; 5% fee
        int prize = stake * 2 - platform_fee;

        ;; Send prize to winner
        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(game_winner)
            .store_coins(prize)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0, 32)
            .end_cell();
        send_raw_message(msg, 1);

        ;; Send fee to platform
        var fee_msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(my_address())
            .store_coins(platform_fee)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0, 32)
            .end_cell();
        send_raw_message(fee_msg, 1);

        save_data(seqno + 1, 2, stake, player1, player2, created_at, game_winner);
        return ();
    }

    ;; op::refund = 3 (draw or timeout)
    if (op == 3) {
        throw_if(406, status != 1);

        ;; Refund both players
        var msg1 = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(player1)
            .store_coins(stake)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0, 32)
            .end_cell();
        send_raw_message(msg1, 1);

        var msg2 = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(player2)
            .store_coins(stake)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0, 32)
            .end_cell();
        send_raw_message(msg2, 1);

        save_data(seqno + 1, 2, stake, player1, player2, created_at, winner);
        return ();
    }
}

;; Get methods
(int) get_status() method_id {
    var (seqno, status, stake, player1, player2, created_at, winner) = load_data();
    return status;
}

(int) get_stake() method_id {
    var (seqno, status, stake, player1, player2, created_at, winner) = load_data();
    return stake;
}
